{
  "expo": {
    "name": "Sarvasvaa Dairy",
    "slug": "milkp-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/sarvaalogo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarvasvaa.dairy",
      "icon": "./assets/sarvaalogo.png"
    },
    "android": {
      "package": "com.sarvasvaa.dairy",
      "versionCode": 1,
      "icon": "./assets/sarvaalogo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sarvaalogo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/sarvaalogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "1e6e0529-2de7-4b69-8ef5-8f389b4c111f"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/sarvaalogo.png",
          "color": "#ffffff"
        }
      ]
    ]
  }
}
