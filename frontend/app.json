{
  "expo": {
    "name": "MilkP Dairy Management",
    "slug": "milkp-dairy-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/sarvaalogo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.milkp.dairymanagement",
      "icon": "./assets/sarvaalogo.png"
    },
    "android": {
      "package": "com.milkp.dairymanagement",
      "versionCode": 1,
      "icon": "./assets/sarvaalogo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sarvaalogo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/sarvaalogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "31d96667-ff24-4bc7-bdaa-fd3412cc1a99"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-asset"
    ]
  }
}
